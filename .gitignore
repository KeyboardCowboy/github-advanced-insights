# This installation's data: accounts, projects, reports, and cache.
# Gitignored here so an upstream pull never conflicts with local configuration
# and a contribution never carries someone's board identifiers. To share a set
# of reports, make this directory its own repository; the .gitignore written
# inside it keeps the personal and derived files out.
/workspace/

# Python bytecode.
__pycache__/
*.py[cod]
